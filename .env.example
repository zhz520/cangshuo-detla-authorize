HOST=127.0.0.1
PORT=17441
DATA_DIR=./.local
AUTHORITY_PRIVATE_KEY=./.local/license-private.pem
OWNER_USERNAME=admin
OWNER_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
COOKIE_SECURE=false
# 生产环境填写实际对外 Origin，不含路径；多个以英文逗号分隔。
AUTHORITY_ALLOWED_ORIGINS=https://auth.example.com
# 32 字节 base64/hex；用于加密保存阿里云短信 Secret 和短信客户端凭据。
AUTHORITY_SMS_MASTER_KEY=
# 短信手机号 HMAC 盐，建议与主密钥分开配置；留空时使用主密钥。
AUTHORITY_SMS_PHONE_HASH_KEY=
SMS_DEFAULT_MODE=HYBRID
SMS_DEFAULT_PRICE_CENTS=5

# 实名二要素核验（按次计费）。服务未配置时客户端会明确返回 503，不会扣费。
# IDENTITY_PROVIDER_URL 必须为 HTTPS；请求体为 {"name":"...","idNumber":"..."}，
# 成功响应至少包含 {"matched":true|false,"requestId":"..."}。
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_TOKEN=
# 每次核验的冻结/扣费金额，单位分；默认 100（1.00 元）。
IDENTITY_PRICE_CENTS=100
# 仅用于生成不可逆主体摘要，不要与登录密码或支付密钥复用。
IDENTITY_SUBJECT_PEPPER=replace-with-a-random-long-secret
# 附加受信的 OpenAI 兼容服务商域名（可选），不接受明文 HTTP 或自定义端口。
SUPPORT_AI_ALLOWED_HOSTS=
# 客服反代的直连 IP，仅这些来源可以提供由反代覆盖的 X-Real-IP；留空不信任转发头。
SUPPORT_TRUSTED_PROXY_IPS=
